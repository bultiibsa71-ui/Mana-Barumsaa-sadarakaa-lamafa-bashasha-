


/* General Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    line-height: 1.6;
    color: #333;
}

.container {
    width: 90%;
    max-width: 1200px;
    margin: auto;
    overflow: hidden;
}

.section-title {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 2rem;
    color: #2c3e50;
    border-bottom: 3px solid #3498db;
    display: inline-block;
    padding-bottom: 0.5rem;
}

.btn {
    display: inline-block;
    background: #3498db;
    color: #fff;
    padding: 0.8rem 2rem;
    border: none;
    border-radius: 5px;
    text-decoration: none;
    font-size: 1.1rem;
    transition: background 0.3s;
    cursor: pointer;
}

.btn:hover {
    background: #2980b9;
}

/* Header */
header {
    background: #2c3e50;
    color: #fff;
    padding: 1.5rem 0;
    text-align: center;
}

header h1 i {
    margin-right: 10px;
    color: #f1c40f;
}

/* Navigation */
nav {
    background: #34495e;
    padding: 1rem 0;
}

nav ul {
    display: flex;
    justify-content: center;
    list-style: none;
}

nav ul li a {
    color: #ecf0f1;
    text-decoration: none;
    padding: 0.5rem 1.5rem;
    margin: 0 0.2rem;
    font-weight: bold;
    transition: all 0.3s;
    border-radius: 20px;
}

nav ul li a:hover {
    background: #e67e22;
    color: #fff;
}

/* Hero Section */
.hero {
    background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('school-bg.jpg') no-repeat center center/cover;
    height: 60vh;
    display: flex;
    align-items: center;
    text-align: center;
    color: #fff;
}

.hero h2 {
    font-size: 3rem;
    margin-bottom: 1rem;
    animation: slideInDown 1s;
}

.hero p {
    font-size: 1.3rem;
    margin-bottom: 2rem;
    animation: slideInUp 1s;
}

/* About Section */
.about {
    padding: 4rem 0;
    background: #f9f9f9;
}

.about-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
}

.about-text p {
    margin-bottom: 1rem;
    font-size: 1.1rem;
}

/* Courses Section */
.courses {
    padding: 4rem 0;
}

.course-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.course-card {
    background: #fff;
    padding: 2rem;
    text-align: center;
    border-radius: 10px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    transition: transform 0.3s;
}

.course-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
}

.course-card i {
    color: #e67e22;
    margin-bottom: 1rem;
}

.course-card h3 {
    margin-bottom: 0.5rem;
    color: #2c3e50;
}

/* Contact Section */
.contact {
    padding: 4rem 0;
    background: #f9f9f9;
}

.contact-info {
    text-align: center;
    margin-bottom: 2rem;
    background: #fff;
    padding: 2rem;
    border-radius: 10px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

.contact-info p {
    margin: 0.8rem 0;
    font-size: 1.1rem;
}

.contact-info i {
    color: #3498db;
    width: 30px;
    margin-right: 10px;
}

.contact-form {
    max-width: 600px;
    margin: auto;
    background: #fff;
    padding: 2rem;
    border-radius: 10px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

.contact-form input,
.contact-form textarea {
    width: 100%;
    padding: 0.8rem;
    margin-bottom: 1rem;
    border: 1px solid #ddd;
    border-radius: 5px;
    font-size: 1rem;
}

.contact-form button {
    width: 100%;
}

/* Footer */
footer {
    background: #2c3e50;
    color: #ecf0f1;
    text-align: center;
    padding: 2rem 0;
    margin-top: 2rem;
}

footer p {
    margin: 0.3rem 0;
}

/* Animations */
@keyframes slideInDown {
    from {
        transform: translateY(-100px);
        opacity: 0;
    }
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

@keyframes slideInUp {
    from {
        transform: translateY(100px);
        opacity: 0;
    }
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

/* Responsive (Bilbilaan) */
@media (max-width: 768px) {
    nav ul {
        flex-direction: column;
        text-align: center;
    }
    nav ul li a {
        display: block;
        margin: 0.2rem 0;
    }
    .about-content {
        grid-template-columns: 1fr;
    }
    .hero h2 {
        font-size: 2rem;
    }
}
